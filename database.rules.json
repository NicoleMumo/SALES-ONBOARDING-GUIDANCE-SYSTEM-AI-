{
  "rules": {
    ".read": false,
    ".write": false,
    "salesAgents": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "fieldRuleOverrides": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },
    "fieldDefinitions": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },
    "onboardingSessions": {
      ".read": "auth != null && auth.token.admin === true",
      "$sessionId": {
        ".read": "auth != null && (auth.token.admin === true || data.child('agentUid').val() === auth.uid)",
        ".write": "auth != null && (auth.token.admin === true || (newData.child('agentUid').val() === auth.uid && (!data.exists() || data.child('agentUid').val() === auth.uid)))"
      }
    }
  }
}
