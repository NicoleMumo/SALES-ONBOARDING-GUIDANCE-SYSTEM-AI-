<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark version of the window theme; colours match DarkColors in Ui.kt. -->
    <color name="app_primary_dark">#FF63D3A8</color>
    <color name="app_background_dark">#FF0F1512</color>

    <style name="Theme.SalesOnboarding" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/app_primary_dark</item>
        <item name="android:windowBackground">@color/app_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/app_background_dark</item>
    </style>
</resources>
